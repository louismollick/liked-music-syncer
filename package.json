{
  "name": "liked-music-syncer",
  "version": "1.0.0",
  "description": "Keeps a local music library in sync with your YouTube Music likes",
  "main": "./out/main/index.js",
  "author": "Louis Mollick",
  "homepage": "https://github.com/louismollick/liked-music-syncer",
  "scripts": {
    "format": "biome format --write .",
    "lint": "biome check .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json --composite false",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web && pnpm typecheck:test",
    "rebuild:native:electron": "electron-rebuild -f -w better-sqlite3",
    "rebuild:native:node": "pnpm rebuild better-sqlite3",
    "dev": "pnpm rebuild:native:electron && env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "start": "pnpm rebuild:native:electron && env -u ELECTRON_RUN_AS_NODE electron-vite preview",
    "test": "pnpm rebuild:native:node && vitest run",
    "build": "pnpm typecheck && electron-vite build",
    "build:unpack": "pnpm rebuild:native:electron && electron-vite build && electron-builder --dir",
    "build:mac": "pnpm rebuild:native:electron && electron-vite build && electron-builder --mac",
    "postinstall": "electron-builder install-app-deps",
    "tools:fetch": "node ./scripts/fetch-tools.mjs"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@tanstack/react-router": "^1.170.8",
    "@tanstack/react-virtual": "^3.13.25",
    "better-sqlite3": "^12.10.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "eld": "^2.1.0",
    "execa": "^9.6.1",
    "ffmpeg-static": "5.3.0",
    "lucide-react": "^1.34.0",
    "node-taglib-sharp": "^6.0.3",
    "sanitize-filename": "^1.6.4",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron/rebuild": "^4.0.4",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.1.6"
  }
}
