{
  "name": "liked-music-syncer",
  "version": "1.0.0",
  "description": "Desktop sync utility for YouTube liked music to tagged local audio files",
  "main": "./out/main/index.js",
  "author": "mollicl",
  "homepage": "https://github.com/mollicl/liked-music-syncer",
  "scripts": {
    "format": "biome format --write .",
    "lint": "biome check .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "rebuild:native": "pnpm rebuild:native:electron",
    "rebuild:native:electron": "pnpm exec electron-rebuild -f -w better-sqlite3",
    "rebuild:native:node": "pnpm rebuild better-sqlite3",
    "start": "pnpm rebuild:native:electron && env -u ELECTRON_RUN_AS_NODE electron-vite preview",
    "dev": "pnpm rebuild:native:electron && env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "test": "pnpm rebuild:native:node && vitest run",
    "build": "pnpm typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "pnpm build && electron-builder --dir",
    "build:win": "pnpm build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "pnpm build && electron-builder --linux",
    "package": "pnpm build:mac",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "tools:fetch": "node ./scripts/fetch-tools.mjs"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@tanstack/react-router": "^1.170.8",
    "@tanstack/react-virtual": "^3.13.25",
    "better-sqlite3": "^12.10.0",
    "drizzle-orm": "^0.45.2",
    "execa": "^9.6.1",
    "ffmpeg-static": "5.3.0",
    "googleapis": "^171.4.0",
    "musicbrainz-api": "^1.2.1",
    "sanitize-filename": "^1.6.4",
    "ytmusic-api": "^5.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron/rebuild": "^4.0.4",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "drizzle-kit": "^0.31.10",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.1.6"
  }
}
